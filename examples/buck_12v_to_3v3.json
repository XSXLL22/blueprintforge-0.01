  "design_rationale": "12V→3.3V 压差 8.7V，若用 LDO 热耗约 17W 不可接受，故选异步 buck。MP1584EN 集成开关管、4.5–28V 输入覆盖适配器电源、3A 裕量满足 2A 输出。开关频率取 ~500kHz，按 (Vout·(Vin−Vout))/(Vin·ΔI·f) 估算电感约 10µH。反馈分压 49.9k/16k 得 0.8×(1+3.119)≈3.30V。SS34 作为续流二极管（异步拓扑必需）。",
  "assumptions": [
    "负载电流 ≤ 2A，环境温度 ≤ 60°C",
    "开关频率约 500kHz（由 R3/C6 补偿网络决定，需按 datasheet 复核）",
    "输入为稳定直流（12V 适配器），无电池电压跌落场景"
  ],
  "risks": [
    "电感感值与饱和电流需按实际开关频率与纹波要求复核",
    "COMP 补偿网络取值必须按 datasheet 典型应用复核，或经 SPICE 验证",
    "纹波指标需打样后实测确认"
  ]
}
